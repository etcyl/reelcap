<Window x:Class="ReelCap.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="ReelCap" Width="980" Height="760"
        WindowStartupLocation="CenterScreen" WindowStyle="None" ResizeMode="CanMinimize"
        Background="{StaticResource Bg}" FontFamily="{StaticResource Font}" Foreground="{StaticResource Text}"
        Icon="icon.png" UseLayoutRounding="True" TextOptions.TextFormattingMode="Display">
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="44" ResizeBorderThickness="6" GlassFrameThickness="0" CornerRadius="0" UseAeroCaptionButtons="False"/>
    </WindowChrome.WindowChrome>

    <Grid x:Name="Root">
        <Grid.RowDefinitions>
            <RowDefinition Height="44"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Title bar -->
        <Grid Grid.Row="0">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="18,0,0,0">
                <Image Source="icon.png" Width="18" Height="18"/>
                <TextBlock Text="ReelCap" FontSize="14" FontWeight="SemiBold" Margin="10,0,0,0" VerticalAlignment="Center"/>
                <Border x:Name="EncoderBadge" CornerRadius="6" Background="{StaticResource Card}" Margin="14,0,0,0" Padding="8,3" VerticalAlignment="Center">
                    <TextBlock x:Name="EncoderText" Text="Detecting encoders..." FontSize="11" Foreground="{StaticResource Muted}"/>
                </Border>
            </StackPanel>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" WindowChrome.IsHitTestVisibleInChrome="True">
                <Button Style="{StaticResource Caption}" Content="&#xE921;" Tag="{StaticResource Card}" Click="Minimize_Click"/>
                <Button Style="{StaticResource Caption}" Content="&#xE8BB;" Tag="#E81123" Click="Close_Click"/>
            </StackPanel>
        </Grid>

        <!-- Body -->
        <Grid Grid.Row="1" Margin="18,6,18,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="300"/>
                <ColumnDefinition Width="18"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Monitors -->
            <Border Grid.Column="0" Background="{StaticResource Panel}" CornerRadius="14" Padding="16">
                <DockPanel>
                    <DockPanel DockPanel.Dock="Top" Margin="0,0,0,4">
                        <Button DockPanel.Dock="Right" Style="{StaticResource Caption}" Width="28" Height="22" Content="&#xE72C;"
                                Tag="{StaticResource Card}" ToolTip="Refresh displays" Click="RefreshMonitors_Click" Margin="0,-4,0,0"/>
                        <TextBlock Text="DISPLAY" Style="{StaticResource Label}"/>
                    </DockPanel>
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel x:Name="MonitorList"/>
                    </ScrollViewer>
                </DockPanel>
            </Border>

            <!-- Settings -->
            <Border Grid.Column="2" Background="{StaticResource Panel}" CornerRadius="14" Padding="22,18">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel x:Name="SettingsPanel">
                        <TextBlock Text="RESOLUTION" Style="{StaticResource Label}"/>
                        <WrapPanel x:Name="ResolutionChips" Margin="0,0,0,14"/>

                        <TextBlock Text="FRAME RATE" Style="{StaticResource Label}"/>
                        <WrapPanel x:Name="FpsChips" Margin="0,0,0,14"/>

                        <TextBlock Text="CLIP LENGTH" Style="{StaticResource Label}"/>
                        <WrapPanel x:Name="LengthChips" Margin="0,0,0,14"/>

                        <Grid Margin="0,0,0,14">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="QUALITY" Style="{StaticResource Label}"/>
                                <WrapPanel x:Name="QualityChips"/>
                            </StackPanel>
                            <StackPanel Grid.Column="1">
                                <TextBlock Text="FORMAT" Style="{StaticResource Label}"/>
                                <WrapPanel x:Name="FormatChips"/>
                            </StackPanel>
                        </Grid>

                        <TextBlock Text="OPTIONS" Style="{StaticResource Label}"/>
                        <WrapPanel Margin="0,2,0,18">
                            <CheckBox x:Name="CursorToggle" Style="{StaticResource Toggle}" Content="Show cursor" Margin="0,0,24,8"/>
                            <CheckBox x:Name="GpuToggle" Style="{StaticResource Toggle}" Content="GPU encoding" Margin="0,0,24,8"/>
                            <CheckBox x:Name="HideToggle" Style="{StaticResource Toggle}" Content="Minimize while recording" Margin="0,0,24,8"/>
                        </WrapPanel>

                        <TextBlock Text="SAVE TO" Style="{StaticResource Label}"/>
                        <DockPanel>
                            <Button DockPanel.Dock="Right" Style="{StaticResource Ghost}" Content="Open" Margin="8,0,0,0" Click="OpenFolder_Click"/>
                            <Button DockPanel.Dock="Right" Style="{StaticResource Ghost}" Content="Change" Margin="8,0,0,0" Click="Browse_Click" x:Name="BrowseButton"/>
                            <Border CornerRadius="9" Background="{StaticResource Card}" BorderBrush="{StaticResource Line}" BorderThickness="1" Padding="12,7">
                                <TextBlock x:Name="FolderText" TextTrimming="CharacterEllipsis" Foreground="{StaticResource Muted}" FontSize="13"/>
                            </Border>
                        </DockPanel>
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>

        <!-- Record bar -->
        <Border Grid.Row="2" Margin="18,18,18,18" Background="{StaticResource Panel}" CornerRadius="14" Padding="18,14">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <Button x:Name="RecordButton" Width="64" Height="64" Cursor="Hand" Click="Record_Click" ToolTip="Start / stop (Ctrl+Alt+R)">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Grid>
                                <Ellipse x:Name="Pulse" Fill="{StaticResource Accent}" Opacity="0" RenderTransformOrigin="0.5,0.5">
                                    <Ellipse.RenderTransform><ScaleTransform/></Ellipse.RenderTransform>
                                </Ellipse>
                                <Ellipse x:Name="Ring" Stroke="#3DFFFFFF" StrokeThickness="2" Fill="{StaticResource Card}"/>
                                <Border x:Name="Dot" Width="30" Height="30" CornerRadius="15" Background="{StaticResource Accent}"/>
                            </Grid>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Ring" Property="Fill" Value="{StaticResource CardHover}"/>
                                </Trigger>
                                <Trigger Property="Tag" Value="rec">
                                    <Setter TargetName="Dot" Property="Width" Value="24"/>
                                    <Setter TargetName="Dot" Property="Height" Value="24"/>
                                    <Setter TargetName="Dot" Property="CornerRadius" Value="6"/>
                                    <Trigger.EnterActions>
                                        <BeginStoryboard x:Name="PulseAnim">
                                            <Storyboard RepeatBehavior="Forever">
                                                <DoubleAnimation Storyboard.TargetName="Pulse" Storyboard.TargetProperty="Opacity" From="0.45" To="0" Duration="0:0:1.4"/>
                                                <DoubleAnimation Storyboard.TargetName="Pulse" Storyboard.TargetProperty="RenderTransform.ScaleX" From="1" To="1.45" Duration="0:0:1.4"/>
                                                <DoubleAnimation Storyboard.TargetName="Pulse" Storyboard.TargetProperty="RenderTransform.ScaleY" From="1" To="1.45" Duration="0:0:1.4"/>
                                            </Storyboard>
                                        </BeginStoryboard>
                                    </Trigger.EnterActions>
                                    <Trigger.ExitActions>
                                        <StopStoryboard BeginStoryboardName="PulseAnim"/>
                                    </Trigger.ExitActions>
                                </Trigger>
                                <Trigger Property="IsEnabled" Value="False">
                                    <Setter Property="Opacity" Value="0.4"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                </Button>

                <StackPanel Grid.Column="1" Margin="18,0,0,0" VerticalAlignment="Center">
                    <TextBlock x:Name="TimerText" Text="00:00" FontSize="26" FontWeight="SemiBold" FontFamily="Segoe UI Variable Display, Segoe UI"/>
                    <TextBlock x:Name="StatusText" Text="Ready" Foreground="{StaticResource Muted}" FontSize="12" TextTrimming="CharacterEllipsis"/>
                    <Border x:Name="ProgressTrack" Height="4" CornerRadius="2" Background="{StaticResource Line}" Margin="0,8,0,0" Visibility="Collapsed" HorizontalAlignment="Stretch">
                        <Border x:Name="ProgressFill" CornerRadius="2" Background="{StaticResource Accent}" HorizontalAlignment="Left" Width="0"/>
                    </Border>
                </StackPanel>

                <StackPanel Grid.Column="2" VerticalAlignment="Center" HorizontalAlignment="Right">
                    <Button x:Name="LastClipButton" Style="{StaticResource Ghost}" Visibility="Collapsed" Click="LastClip_Click" HorizontalAlignment="Right">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE768;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" VerticalAlignment="Center" Margin="0,0,8,0"/>
                            <TextBlock x:Name="LastClipText" Text="Play last clip"/>
                        </StackPanel>
                    </Button>
                    <TextBlock Text="Ctrl + Alt + R  to start or stop" Foreground="{StaticResource Muted}" FontSize="11" Margin="0,8,0,0" HorizontalAlignment="Right"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
